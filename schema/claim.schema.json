{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeAnchor Claim",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "status",
    "scope",
    "stance",
    "evidence",
    "falsifiers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable readable slug; never rename after the claim is referenced.",
      "pattern": "^claim-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "type": {
      "const": "claim"
    },
    "status": {
      "enum": [
        "asserted",
        "verified",
        "refuted",
        "stale"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    },
    "paper": {
      "type": "string"
    },
    "stance": {
      "enum": [
        "adopt",
        "trial",
        "watch",
        "avoid"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "locator",
          "quote",
          "relation"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "relation": {
            "enum": [
              "supports",
              "contradicts"
            ]
          }
        }
      }
    },
    "falsifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "review_due": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signoff": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "by",
        "at",
        "method",
        "evidence_hash"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "method": {
          "enum": [
            "read",
            "reproduced",
            "cross-checked"
          ]
        },
        "evidence_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "signoff",
          "review_due"
        ],
        "properties": {
          "signoff": {
            "type": "object"
          }
        }
      }
    }
  ]
}
